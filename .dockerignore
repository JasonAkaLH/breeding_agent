# VCS / local agent state
.git/
.[c]odex/
.omx/
.superpowers/
.github/
.DS_Store
**/.DS_Store
.idea/
.vscode/

# Root-level documents must not enter Docker context/images.
/*.md
/本周工作周报.md

# Keep only the shipped static API document from docs/.
docs/**
!docs/api/
!docs/api/**

# Tests and generated caches are not runtime inputs.
tests/
**/tests/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
.tox/
.nox/

# Frontend local dependencies/build output are rebuilt inside Docker.
frontend/node_modules/
frontend/dist/
frontend/coverage/

# Runtime data is mounted as a Compose volume.
runtime/

# Python local env/build artifacts.
.venv/
venv/
env/
.python-version
.env
build/
dist/
site/
pip-wheel-metadata/
*.egg-info/
.eggs/

# Native/Rust build outputs and local reports.
native/target/
native/fuzz/target/

# Skill-local non-runtime examples/docs/tests; keep Skill manifests, scripts,
# configs, and runtime modules.
skill/**/docs/
skill/**/examples/
skill/**/outputs/

# Test sources/scripts are local-only and must not enter Docker context/images.
frontend/src/*.test.ts
frontend/src/*.test.tsx
frontend/src/*.spec.ts
frontend/src/*.spec.tsx
frontend/src/**/*.test.ts
frontend/src/**/*.test.tsx
frontend/src/**/*.spec.ts
frontend/src/**/*.spec.tsx
frontend/src/test/
mcp_test.json
scripts/smoke_*.py
scripts/validate_*.py
scripts/run_rust_coverage_thresholds.py
scripts/run_rust_quality_gates.py
scripts/prd_evidence.py
