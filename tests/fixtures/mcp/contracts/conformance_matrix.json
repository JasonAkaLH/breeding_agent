  "items": [
    {
      "id": "MCP-CONF-CLIENT-2024-TRANSPORT",
      "phase": "client_compatibility",
      "versions": [
        "2024-11-05"
      ],
      "requirement": "2024-11-05 client conformance uses legacy HTTP+SSE transport evidence for initialize, tools/list, tools/call, batch rejection, raw id redaction, and safe diagnostics."
    },
    {
      "id": "MCP-CONF-CLIENT-2024-PERSISTENT-SSE",
      "phase": "client_compatibility",
      "versions": [
        "2024-11-05"
      ],
      "requirement": "2024-11-05 legacy HTTP+SSE client conformance covers persistent SSE reader, endpoint event POST URI discovery, original SSE message response id correlation, notification 204/no-body success, timeout pending cleanup, and close cleanup."
    },
    {
      "id": "MCP-CONF-CLIENT-2025-TRANSPORT",
      "phase": "client_compatibility",
      "versions": [
        "2025-03-26",
        "2025-06-18",
        "2025-11-25"
      ],
      "requirement": "2025+ client conformance uses Streamable HTTP transport evidence for initialize, tools/list, tools/call, batch rejection, raw id redaction, and safe diagnostics."
    },
    {
      "id": "MCP-CONF-CLIENT-2026-STATELESS",
      "phase": "client_compatibility",
      "versions": [
        "2026-07-28"
      ],
      "requirement": "2026-07-28 Python adapter conformance covers server/discover, per-request metadata and header routing, stateless JSON/SSE responses, cache hints, MRTR, and Tasks normalization."
    },
    {
      "id": "MCP-CONF-BATCH-REJECTION",
      "phase": 0,
      "requirement": "JSON-RPC data layer messages are object-only; batch arrays fail closed for every supported client protocol version."
    },
    {
      "id": "MCP-CONF-SAFE-DIAGNOSTICS",
      "phase": 0,
      "requirement": "Conformance evidence may include safe diagnostic summaries only and must not store raw endpoint, session id, Last-Event-ID, progressToken, token, or tool output."
    },
    {
      "id": "MCP-CONF-001",
      "phase": 0,
      "requirement": "POST request, notification, and response fixtures exist; notification/response accepts HTTP 202 no body."
    },
    {
      "id": "MCP-CONF-002",
      "phase": 0,
      "requirement": "SSE fixtures cover multi-line data, empty priming event, comment, heartbeat, id, retry, malformed and oversized events."
    },
    {
      "id": "MCP-CONF-003",
      "phase": 0,
      "requirement": "Session 404 reinitialize and GET/DELETE 405 compatibility paths are fixture-covered."
    },
    {
      "id": "MCP-CONF-004",
      "phase": 0,
      "requirement": "Task fixtures cover taskSupport missing as forbidden, related-task metadata, progress token type and monotonicity for the latest-feature long-task track."
    },
    {
      "id": "MCP-CONF-005",
      "phase": 0,
      "requirement": "Frontend event schema contains only safe fields and raw ids/secrets/endpoints are forbidden by redaction snapshots."
    }
  ],
