{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maf.mcp.frontend_events.v1",
  "type": "object",
  "required": [
    "event_type",
    "payload"
  ],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "mcp.long_task_started",
        "mcp.long_task_progress",
        "mcp.long_task_status",
        "mcp.long_task_reconnected",
        "mcp.long_task_cancel_requested",
        "mcp.long_task_cancelled",
        "mcp.long_task_failed",
        "mcp.long_task_completed"
      ]
    },
    "payload": {
      "type": "object",
      "required": [
        "safe_ref"
      ],
      "properties": {
        "server_id": {
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        },
        "capability_id": {
          "type": "string"
        },
        "safe_ref": {
          "type": "string",
          "pattern": "^mcp-task:[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+:[A-Fa-f0-9]{16,32}$"
        },
        "progress": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "message": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "status_message": {
          "type": "string"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string"
        },
        "error_code": {
          "type": "string"
        },
        "retriable": {
          "type": "boolean"
        },
        "output_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
