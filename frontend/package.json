{
  "name": "breeding-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:mathjax": "node scripts/prepare_mathjax_assets.mjs",
    "predev": "npm run prepare:mathjax",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run prepare:mathjax",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pretest": "npm run prepare:mathjax",
    "test": "vitest",
    "test:unit": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "antd": "5.29.3",
    "mathjax": "4.1.3",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "29.1.0",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  }
}
